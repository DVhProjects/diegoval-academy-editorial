{
  "timezone": "Europe/Stockholm",
  "language": "es",
  "calendar": {
    "miercoles": {
      "type": "oportunidad",
      "publish_time": "12:30"
    },
    "viernes": {
      "type": "research_career",
      "publish_time": "12:30"
    },
    "sabado": {
      "type": "educativo",
      "publish_time": "11:00",
      "share_now_after": "10:45"
    }
  },
  "rules": {
    "min_days_before_deadline": 7,
    "caption_max_chars": 1300,
    "image_size": [
      1080,
      1350
    ],
    "friday_categories": [
      "tendencia_europea",
      "idea_tesis",
      "carrera_phd",
      "programa_red"
    ],
    "style_version": 3,
    "saturday_categories": [
      "becas_paso_a_paso",
      "buscar_doctorado",
      "preparar_solicitud",
      "entender_requisitos",
      "encontrar_oportunidades",
      "entrevista_util"
    ],
    "plain_language": true
  },
  "media": {
    "_nota": "Buffer exige una URL pública y permanente para la imagen. Se usa un repositorio GitHub público; la URL se fija al SHA del commit (inmutable).",
    "github_owner": "DVhProjects",
    "github_repo": "diegoval-academy-editorial",
    "raw_url_template": "https://raw.githubusercontent.com/{owner}/{repo}/{sha}/{path}"
  },
  "calendar_defaults": {
    "publish_time": "12:30",
    "share_now_after": "12:15"
  },
  "mode": "produccion",
  "_modo": "La rutina semanal publica de verdad. Las pruebas usan rutinas aparte con --draft, rama claude/prueba-* y status draft-test; nunca main ni el historial de producción."
}
